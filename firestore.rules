rules_version = '2';

/* =========================================================
   UDUF Africa — Firestore security rules
   ------------------------------------------------------------
   Model: attendees are written only by Cloud Functions
   (Admin SDK bypasses these rules), and read by a staff
   member through a callable function. The browser never gets
   list or get access to the collection, so a leaked API key
   cannot expose the attendee list.

   Deploy with:
     firebase deploy --only firestore:rules
   ========================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    match /attendees/{ticketCode} {

      /* Default: nothing is client-readable or client-writable. */
      allow read, write: if false;

      /* Optional self-service: lets a named attendee read back
         their own record using a token issued at checkout.
         Leave commented out unless you implement that flow. */
      allow get: if false
        && request.auth != null
        && request.auth.token.ticketCode == ticketCode;
    }

    /* Public, non-personal configuration (event dates, capacity,
       price list) may be read by anyone. */
    match /eventConfig/{docId} {
      allow read: if true;
      allow write: if false;
    }

    /* Catch-all: deny by default. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
